{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Figma page specification",
  "type": "object",
  "required": ["version", "page", "variants", "tokens", "sections", "assets", "openQuestions"],
  "properties": {
    "version": { "const": 1 },
    "page": { "type": "object" },
    "variants": { "type": "array", "minItems": 1 },
    "tokens": { "type": "object" },
    "sections": { "type": "array", "minItems": 1 },
    "assets": { "type": "array" },
    "openQuestions": { "type": "array" }
  }
}

