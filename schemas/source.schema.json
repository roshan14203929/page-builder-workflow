{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Layerlift source snapshot",
  "type": "object",
  "required": ["id", "status", "figma", "createdAt", "completedAt", "warnings"],
  "properties": {
    "id": { "type": "string", "pattern": "^source-[0-9]{3,}$" },
    "status": { "enum": ["EXTRACTING", "READY", "FAILED"] },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "extractionMode": { "enum": ["FULL", "INCREMENTAL"] },
    "baseSourceId": { "type": ["string", "null"], "pattern": "^source-[0-9]{3,}$" },
    "changeSet": {
      "type": ["object", "null"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": "string", "minLength": 1 },
        "changedNodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["variantLabel", "nodeId"],
            "properties": {
              "variantLabel": { "type": "string" },
              "nodeId": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" }
            }
          }
        }
      }
    },
    "figma": {
      "type": "object",
      "required": ["url", "variants"],
      "properties": {
        "url": { "type": "string" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string" },
              "nodeId": { "type": ["string", "null"] },
              "width": { "type": ["number", "null"] },
              "height": { "type": ["number", "null"] },
              "reference": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "referenceState": {
      "type": "object",
      "additionalProperties": { "enum": ["PENDING", "REUSED", "STALE", "REFRESHED"] }
    },
    "provenance": { "type": "object" },
    "callLedger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "operation", "status"],
        "properties": {
          "at": { "type": "string" },
          "operation": { "type": "string" },
          "nodeId": { "type": ["string", "null"] },
          "status": { "enum": ["SUCCESS", "TRANSIENT_ERROR", "AUTH_ERROR", "RATE_LIMITED", "FAILED"] },
          "retryAfterSeconds": { "type": ["number", "null"], "minimum": 0 },
          "message": { "type": ["string", "null"] }
        }
      }
    },
    "rateLimit": { "type": "object" },
    "forceNewReason": { "type": ["string", "null"] },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
